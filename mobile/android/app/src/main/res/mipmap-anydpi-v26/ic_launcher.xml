<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (Android 8+).

  Without this, the launcher applies its circular or squircle mask to the flat
  108dp bitmap and clips the corners off the logo. Splitting it into a
  background and a foreground lets the system mask the background only, and the
  foreground is drawn inside the safe zone — the inner ~66% — so nothing of the
  mark is ever cut.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
