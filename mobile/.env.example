# =============================================================================
# Sathify Flutter app — environment template
#
#   cp .env.example .env
#
# This file is bundled as a Flutter asset, so treat everything in it as
# PUBLICLY READABLE by anyone who downloads the APK. Never put a secret here.
# Only the Razorpay *public* key id and the API base URL belong in this file;
# every real secret stays on the Django server.
# =============================================================================

# --- Backend API -------------------------------------------------------------
# Defaults to the SHARED DEPLOYED API, so a fresh clone works on any device,
# on any network, with no laptop running and no database credentials. Everyone
# on the team sees the same data. This is the setup you want for testing.
#
# Not a secret: this file is bundled as a Flutter asset, so the URL ships
# readable inside the APK no matter what. Safe to commit.
API_BASE_URL=https://sathify-api.onrender.com/api/v1

# Working on the BACKEND and want the app to hit your own machine instead?
# Do not edit the line above — override it per-run, so your normal setup
# survives and you never commit a local address by accident:
#
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000/api/v1        # emulator
#   flutter run --dart-define=API_BASE_URL=http://192.168.1.42:8000/api/v1    # real phone, your LAN IP
#
# A --dart-define always wins over the value above. Note the emulator reaches
# your host machine at 10.0.2.2, NOT localhost; a real phone needs your LAN IP
# and `runserver 0.0.0.0:8000`. See "Running on a physical phone" in README.md.
#
# The value is read at BUILD time, not run time: after changing it, a full
# rebuild (or `flutter run` again) is required — hot reload will not pick it up.

# Request timeout. Kept generous because Render's free tier sleeps after 15
# minutes idle and the first request after a cold start can take ~50 seconds.
API_TIMEOUT_SECONDS=60

# --- Module 8: Razorpay (TEST MODE) ------------------------------------------
# The PUBLIC key id only — starts with "rzp_test_".
# The key SECRET must never appear in the mobile app.
RAZORPAY_KEY_ID=

# --- Feature flags -----------------------------------------------------------
ENABLE_FACE_VERIFICATION=true
ENABLE_AI_CHATBOT=true
# Metres within which a resident may GPS self check-in a worker (Module 13.3).
GEOFENCE_RADIUS_METERS=150
