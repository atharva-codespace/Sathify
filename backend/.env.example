# =============================================================================
# Sathify backend — environment template
#
#   cp .env.example .env      (then fill in the values you have)
#
# EVERY value below is optional for local development. With an empty .env the
# project still runs: the database falls back to SQLite and each integration
# degrades to its documented manual path. Fill values in as you obtain them.
#
# NEVER commit the real .env — it is git-ignored. Commit only this template.
# =============================================================================

# --- Django core -------------------------------------------------------------
# Generate a fresh key for any deployed environment:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SATHIFY_LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------
# Leave BLANK to use local SQLite (default, no setup required).
#
# To use the shared Supabase database, paste the "Session pooler" connection
# string from Supabase > Project Settings > Database > Connection string > URI,
# exactly as given — both postgresql:// and postgres:// parse correctly.
#
# Use the POOLER (port 6543), not the direct connection (5432): Render free
# instances restart often and the pooler tolerates that far better.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# THIS VALUE IS A SECRET — it grants full read/write on every table. It is
# gitignored; never commit it. Get it from a teammate privately, not from the
# repo. Full walkthrough: docs/cloud-database.md
DATABASE_URL=
DB_CONN_MAX_AGE=60

# --- JWT (Module 1) ----------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# --- CORS --------------------------------------------------------------------
# Only needed for Flutter Web. A Flutter Android build sends no Origin header.
CORS_ALLOWED_ORIGINS=

# --- Module 4: Discovery & hiring ---------------------------------------------
# How long a worker has to answer a hire request before it lapses. Expiry is
# evaluated lazily on read, so changing this also affects requests already in
# flight — shorten it when demoing, so a lapse is watchable in one sitting.
HIRE_REQUEST_RESPONSE_HOURS=48

# =============================================================================
# Module 12 — AI layer. Four tiers, tried strictly in order until one succeeds.
# All four are genuinely free: no card on file, no data-sharing trade.
# Missing keys are skipped automatically, so you can add them one at a time.
# =============================================================================

# --- TIER 1: Google Gemini (primary) -----------------------------------------
# Get from https://aistudio.google.com/apikey  (Google account only, no card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- TIER 2: Groq -------------------------------------------------------------
# The LPU inference company Groq — NOT xAI's Grok. Different companies.
# Get from https://console.groq.com/keys  (no card required)
# GROQ_MODEL is config, not code: swap Llama <-> Qwen3-32B by editing this line.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b

# --- TIER 3: OpenRouter -------------------------------------------------------
# Get from https://openrouter.ai/keys  (email sign-up, no card)
#
# LIMITS on the free tier: 20 requests/minute AND 50 requests/DAY per account.
# (1,000/day requires a one-time $10 credit purchase — out of scope here.)
# The AI layer enforces the 50/day cap locally so this tier fails over to
# Tier 4 cleanly instead of returning errors.
#
# The model ID MUST end in ":free". OpenRouter's free catalogue rotates, so
# expect to update this occasionally — unlike Tiers 1 and 2, it is not
# set-and-forget. Current free models: https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1-distill-llama-70b:free
OPENROUTER_DAILY_CAP=50
OPENROUTER_MINUTE_CAP=20

# --- TIER 4: Hugging Face Inference API (last resort) -------------------------
# Get from https://huggingface.co/settings/tokens  (a READ token is enough)
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# NOTE: xAI's Grok is deliberately NOT part of this chain. See settings/base.py.

AI_ENABLED=True
AI_TIMEOUT_SECONDS=30
AI_LOG_LEVEL=DEBUG

# =============================================================================
# Module 3 — OCR pipeline (needs: pip install -r requirements/ml.txt)
# =============================================================================
OCR_PRIMARY_ENGINE=paddleocr
OCR_FALLBACK_ENGINE=easyocr
OCR_LANGUAGES=en
# Below this confidence a critical field (above all the Aadhaar number) is
# never auto-filled — it is flagged for the worker to confirm manually.
OCR_CONFIDENCE_THRESHOLD=0.85
# Largest document upload accepted, in bytes (default 10 MB). A phone photo of
# an Aadhaar card is well under this; the cap exists to stop an accidental
# multi-page PDF scan from occupying the single Render worker for minutes.
OCR_MAX_UPLOAD_BYTES=10485760

# =============================================================================
# Module 7 — Face verification (needs: pip install -r requirements/ml.txt)
# =============================================================================
FACE_VERIFICATION_ENABLED=True
FACE_MODEL=Facenet
# yunet, not opencv. DeepFace's "opencv" backend calls cv2.CascadeClassifier,
# which OpenCV 5.x REMOVED, so every comparison fails with "module 'cv2' has no
# attribute 'CascadeClassifier'" on any machine where an opencv-python 5.x wheel
# wins over the 4.x pin in requirements/cv.txt. YuNet is OpenCV's own DNN
# detector (cv2.FaceDetectorYN), works on both 4.x and 5.x, and is more accurate
# than Haar cascades.
FACE_DETECTOR_BACKEND=yunet
FACE_DISTANCE_METRIC=cosine

# =============================================================================
# Module 8 — Razorpay (TEST MODE ONLY — never put live keys here)
# Get from https://dashboard.razorpay.com > Settings > API Keys, in Test Mode.
# A test key id always starts with "rzp_test_".
# =============================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TEST_MODE=True

# =============================================================================
# Module 8.9 — UPI QR ("pay with FamPay/GPay/PhonePe by scanning")
# =============================================================================
# Nothing to set. The QR is opened through Razorpay using the keys above, so it
# settles automatically through the same signed webhook a card payment does.
#
# ** RAZORPAY_WEBHOOK_SECRET is what makes that automatic. ** Without it the
# webhook endpoint rejects every delivery, so a scanned QR would take the money
# and leave the payment showing unpaid. Register the webhook in the Razorpay
# dashboard for `qr_code.credited`, `payment.captured` and `payment.failed`, and
# paste its secret above.
#
# (An earlier version collected into a plain VPA via UPI_VPA / UPI_PAYEE_NAME /
# UPI_MCC. Those are gone — delete them from your .env if present.)

# =============================================================================
# Module 10 — Firebase Cloud Messaging
# Firebase Console > Project Settings > Service accounts > Generate new private
# key. Save the JSON OUTSIDE the repo (it is git-ignored) and point to it here.
# =============================================================================
FCM_ENABLED=False
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# =============================================================================
# Module 10.2 — SMS fallback, tried when push does not land
# Provider-agnostic: any gateway that accepts a POST with an API key works, so
# the field names are configuration rather than code. Left off by default —
# every free tier meters SMS, and a misconfigured loop is expensive.
# =============================================================================
SMS_ENABLED=False
SMS_ENDPOINT=
SMS_API_KEY=
SMS_SENDER_ID=SATHFY
SMS_TO_FIELD=to
SMS_MESSAGE_FIELD=message

# =============================================================================
# Supabase Storage (production media: worker photos + Aadhaar uploads)
# Supabase > Project Settings > Storage > S3 connection.
# Render's disk is EPHEMERAL, so uploaded files must not live on it.
# =============================================================================
SUPABASE_STORAGE_BUCKET=sathify-media
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_ACCESS_KEY=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_REGION=ap-south-1
