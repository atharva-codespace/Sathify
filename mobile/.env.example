# =============================================================================
# Sathify Flutter app — environment template
#
#   cp .env.example .env
#
# This file is bundled as a Flutter asset, so treat everything in it as
# PUBLICLY READABLE by anyone who downloads the APK. Never put a secret here.
# Only the Razorpay *public* key id and the API base URL belong in this file;
# every real secret stays on the Django server.
# =============================================================================

# --- Backend API -------------------------------------------------------------
# Android emulator reaches the host machine at 10.0.2.2, NOT localhost.
#   Android emulator  -> http://10.0.2.2:8000/api/v1
#   Physical device   -> http://<your-laptop-LAN-ip>:8000/api/v1
#   Deployed (Render) -> https://<your-service>.onrender.com/api/v1
#
# Leaving this blank is safe: AppConfig falls back to 10.0.2.2 on Android and
# 127.0.0.1 everywhere else, both on port 8000.
#
# For a one-off run against a different backend — a physical device on your
# Wi-Fi, or the deployed API — pass it on the command line instead of editing
# this file, so your normal setup survives:
#   flutter run --dart-define=API_BASE_URL=http://192.168.1.42:8000/api/v1
# A --dart-define always wins over the value below.
API_BASE_URL=http://10.0.2.2:8000/api/v1

# Request timeout. Kept generous because Render's free tier sleeps after 15
# minutes idle and the first request after a cold start can take ~50 seconds.
API_TIMEOUT_SECONDS=60

# --- Module 8: Razorpay (TEST MODE) ------------------------------------------
# The PUBLIC key id only — starts with "rzp_test_".
# The key SECRET must never appear in the mobile app.
RAZORPAY_KEY_ID=

# --- Feature flags -----------------------------------------------------------
ENABLE_FACE_VERIFICATION=true
ENABLE_AI_CHATBOT=true
# Metres within which a resident may GPS self check-in a worker (Module 13.3).
GEOFENCE_RADIUS_METERS=150
